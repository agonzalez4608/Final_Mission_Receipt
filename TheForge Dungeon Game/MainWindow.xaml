<!-- MainWindow.xaml — Main game screen layout -->
<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dungeon Explorer" Height="700" Width="1000"
        Background="#1A1814" Loaded="MainWindow_Loaded">

    <Grid>
        <!-- Define 3 columns: left panel | center | right panel -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Player stats -->
        <StackPanel Grid.Column="0" Background="#2E2B25" Margin="0,0,2,0">
            <Label x:Name="lblPlayerName" Content="Player Name"
             Foreground="#C9A84C" FontSize="16" FontWeight="Bold" Margin="10"/>
            <Label Content="Health:" Foreground="White" Margin="10,0,10,0"/>
            <ProgressBar x:Name="pbarPlayerHealth" Height="16"
                   Foreground="#AA3030" Margin="10,0,10,5"/>
            <Label x:Name="lblPlayerHealth" Content="100 / 100"
             Foreground="White" FontSize="12" Margin="10,0"/>
            <Separator Background="#444" Margin="10,8"/>
            <Label Content="INVENTORY" Foreground="#C9A84C"
             FontSize="11" FontWeight="Bold" Margin="10,0"/>
            <ListBox x:Name="lstInventory" Background="#1A1814"
               Foreground="White" Height="150" Margin="10,5"/>
        </StackPanel>

        <!-- CENTER PANEL: Room view -->
        <Grid Grid.Column="1" Margin="2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <Label x:Name="lblRoomName" Grid.Row="0"
             Content="Entrance Hall" Foreground="#F0D080"
             FontSize="22" FontWeight="Bold" Margin="10,10,10,0"/>

            <Image x:Name="imgRoom" Grid.Row="1" Stretch="UniformToFill"
             Margin="10"/>
            <TextBox x:Name="txtRoomDescription"
             Grid.Row="2"
             IsReadOnly="True"
             TextWrapping="Wrap"
             Margin="10,4"/>
            <!-- Direction buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                  HorizontalAlignment="Center" Margin="0,6">
                <Button x:Name="btnNorth" Content="▲ North" Width="90" Margin="4" Click="btnNorth_Click"/>
                <Button x:Name="btnSouth" Content="▼ South" Width="90" Margin="4" Click="btnSouth_Click"/>
                <Button x:Name="btnEast" Content="▶ East" Width="90" Margin="4" Click="btnEast_Click"/>
                <Button x:Name="btnWest" Content="◀ West" Width="90" Margin="4" Click="btnWest_Click"/>
            </StackPanel>

            <!-- Combat log -->
            <TextBox x:Name="txtCombatLog" Grid.Row="4"
               IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Background="#0E0C0A" Foreground="#C9E0A0"
               FontFamily="Consolas" FontSize="12" Margin="10,4,10,10"/>
        </Grid>

        <!-- RIGHT PANEL: Enemy + actions -->
        <StackPanel Grid.Column="2" Background="#2E2B25" Margin="2,0,0,0">
            <Label x:Name="lblEnemyStatus" Content="Room is clear."
             Foreground="White" FontSize="13" Margin="10"/>
            <ProgressBar x:Name="pbarEnemyHealth" Height="14"
                   Foreground="#8B0000" Margin="10,0"/>
            <Button x:Name="btnAttack" Content="⚔ Attack"
        Visibility="Collapsed" Margin="10,8" Click="btnAttack_Click"/>
            <Button x:Name="btnTalkToNpc" Content="💬 Talk"
        Visibility="Collapsed" Margin="10,4" Click="btnTalkToNpc_Click"/>
            <Button x:Name="btnSave" Content="💾 Save Game" Margin="10,4" Click="btnSave_Click"/>
        </StackPanel>
        <Border x:Name="pnlDialogue"
        Grid.RowSpan="2"
        Grid.ColumnSpan="3"
        Background="#CC000000"
        Visibility="Collapsed"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="20"
        Width="420">

            <StackPanel>
                <Label x:Name="lblNpcName"
               Content="NPC"
               Foreground="White"
               FontSize="18"
               FontWeight="Bold"/>

                <TextBlock x:Name="txtNpcDialogue"
                   Text="Dialogue goes here."
                   Foreground="White"
                   TextWrapping="Wrap"
                   Margin="0,10"/>

                <Button x:Name="btnCloseDialogue"
                Content="Close"
                Width="100"
                HorizontalAlignment="Right"
                Click="btnCloseDialogue_Click"/>
            </StackPanel>

        </Border>
    </Grid>
</Window>